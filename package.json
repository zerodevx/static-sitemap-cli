{
  "name": "static-sitemap-cli",
  "version": "3.0.0",
  "description": "CLI to generate XML sitemaps for static sites from local filesystem",
  "author": "Jason Lee <jason@zerodevx.com>",
  "scripts": {
    "emit": "tsc index.js -d --emitDeclarationOnly --allowJs && prettier --write index.d.ts",
    "lint": "npm run emit && prettier --check . && eslint && npx publint",
    "test": "npm run lint && node --test"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "static-sitemap-cli": "./cli.js",
    "sscli": "./cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "ISC",
  "homepage": "https://github.com/zerodevx/static-sitemap-cli",
  "repository": "github:zerodevx/static-sitemap-cli",
  "keywords": [
    "sscli",
    "sitemap",
    "static-site",
    "sitemap-generator",
    "filesystem",
    "xml",
    "txt",
    "cli"
  ]
}
